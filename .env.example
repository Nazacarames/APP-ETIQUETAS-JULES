# Polylens: copiá este archivo a .env y completá lo que quieras usar. Nunca subas .env al repo.
# Todo es opcional: sin nada, Polylens analiza Polymarket y clasifica con palabras clave en vez de Jev.

# Jev (TypeSafe AI, https://typesafe.ai): categorías de mercados y lectura de titulares.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_S=10          # segundos por pedido
JEV_MAX_RETRIES=3
JEV_SAMPLES=1             # >1 promedia varias respuestas (cuesta más)
JEV_MOCK=0                # 1 = usar la heurística local aunque haya clave

# Datos
DATA_DIR=data             # resultados (scans/, flows/, studies/, news/) y caché
CACHE_TTL_S=21600         # cuánto se reutiliza una respuesta de Polymarket (6 h)
POLY_MIN_INTERVAL_S=0.25  # pausa mínima entre pedidos a Polymarket
