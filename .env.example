# Copiá este archivo a .env y completá. Nunca subas .env a git.

# --- Jev (TypeSafe AI) --- https://console.typesafe.ai  (early access)
# Sin key, el bot usa MockJev (heurística local, NO es Jev).
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT_S=3
JEV_SAMPLES=1            # >1 promedia N respuestas (más estable, N veces el costo)

# --- Umbrales del juez (los aplica el código, no Jev) ---
GATE_MIN_REGIME_CONF=0.40
GATE_MIN_SETUP_SCORE=1.0
GATE_FULL_SIZE_CONF=0.70
GATE_MAX_OVEREXTENDED=0.70
GATE_MAX_NEWS_RISK=0.60
GATE_FAIL_CLOSED=true    # si Jev no responde, no se abre nada

# --- Riesgo ---
RISK_PER_TRADE=0.01
RISK_MAX_POSITION_PCT=0.50
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.25

# --- Costos simulados ---
COST_FEE_BPS=10
COST_SLIPPAGE_BPS=5

# --- Broker (opcional, solo cuenta PAPER) ---
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=

# Dinero real: déjalo en false. Cambiarlo es una decisión tuya, no del agente.
LIVE_TRADING=false
