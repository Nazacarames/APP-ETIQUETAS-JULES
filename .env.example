# Polylens: copiá este archivo a .env y completá lo que quieras usar. Nunca subas .env al repo.
# Todo es opcional: sin nada, Polylens analiza Polymarket y clasifica con palabras clave en vez de Jev.

# Jev (TypeSafe AI, https://typesafe.ai): categorías de mercados y lectura de titulares.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_S=10          # segundos por pedido
JEV_MAX_RETRIES=3
JEV_SAMPLES=1             # >1 promedia varias respuestas (cuesta más)
JEV_MOCK=0                # 1 = usar la heurística local aunque haya clave

# Datos
DATA_DIR=data             # resultados (scans/, flows/, studies/, news/, futbol/) y caché
CACHE_TTL_S=21600         # cuánto se reutiliza una respuesta de Polymarket (6 h)
POLY_MIN_INTERVAL_S=0.25  # pausa mínima entre pedidos a Polymarket

# Analista de fútbol argentino (python3 -m futbol). Clave gratis en https://www.api-football.com
APIFOOTBALL_KEY=
FUTBOL_COMPETENCIAS=1032:2024,128:2024   # liga:temporada; el plan gratis solo da 2022-2024 (2026 = plan pago)
FUTBOL_CASA=Bet365                       # casa cuyas cuotas se comparan (ID 8 en API-Football)
FUTBOL_CAPITAL=100                       # toda simulación arranca con 100 USD
FUTBOL_MAX_APUESTA=0.03                  # tope por apuesta: 3 % del capital
FUTBOL_MIN_VALOR=0.05                    # sugerir solo si el modelo ve al menos 5 % de valor
APIFOOTBALL_MIN_INTERVAL_S=6.5           # el plan gratis permite ~10 pedidos por minuto
